diff --git a/src/android/Soundpacks.h b/src/android/Soundpacks.h
new file mode 100644
index 0000000..362e6cb
--- /dev/null
+++ b/src/android/Soundpacks.h
@@ -0,0 +1,61 @@
+#pragma once
+
+#include "../SoundFontLibrary.h"
+
+#include <functional>
+#include <vector>
+
+namespace usf2 {
+
+/** Android only: SF2 content through soundpack-provider-for-android's C API. The plugin's own
+    linked folders (LocalSf2FolderProvider), installed SF2 pack apps and the folders shared in
+    the Soundpack Manager all come through here. Every function blocks on IPC: never call them
+    from the audio thread. */
+namespace soundpacks {
+
+struct Entry
+{
+    juce::String identity;     // commons-soundpack://sf2/... - what the plugin state stores
+    juce::String packLabel;
+    juce::String path;         // within the pack
+    juce::String label;
+    std::vector<PresetInfo> presets; // from the pack's index; the file is not opened
+};
+
+struct Folder
+{
+    juce::String id;
+    juce::String name;
+    juce::String treeUrl;
+    bool available = false;
+    int fileCount = 0;
+    juce::String error;
+};
+
+/** Every SF2 entry the app can read. */
+std::vector<Entry> listEntries();
+
+/** The folders this app linked for SF2. */
+std::vector<Folder> folders();
+
+/** Links and scans a folder the app's picker returned. Returns the folder id, or an empty
+    string with [error] set. Scanning reads every SF2's preset headers once: slow for large
+    folders, so call it off the message thread. */
+juce::String addFolder (const juce::String& treeUrl, juce::String& error);
+
+bool removeFolder (const juce::String& folderId);
+
+/** Rescans every linked folder, so files added since show up. */
+void rescanFolders();
+
+/** The identity of [path] in the linked folder [folderId]. */
+juce::String identityOf (const juce::String& folderId, const juce::String& path);
+
+/** Maps an entry's file and passes its bytes to [use], then releases the mapping. Returns
+    false with [error] set when the entry cannot be opened. */
+bool withMappedEntry (const juce::String& identity,
+                      const std::function<void (const void* data, size_t size)>& use,
+                      juce::String& error);
+
+} // namespace soundpacks
+} // namespace usf2
diff --git a/src/android/Soundpacks.cpp b/src/android/Soundpacks.cpp
new file mode 100644
index 0000000..53b4020
--- /dev/null
+++ b/src/android/Soundpacks.cpp
@@ -0,0 +1,196 @@
+// Before any JUCE header: juce::getEnv() and juce::getAppContext() are declared only then.
+#define JUCE_CORE_INCLUDE_JNI_HELPERS 1
+
+#include "Soundpacks.h"
+
+#include "../SoundFontLibrary.h"
+
+#include <soundpack_host.h>
+
+#include <algorithm>
+#include <mutex>
+
+namespace usf2::soundpacks {
+
+namespace
+{
+    juce::String text (const char* utf8) { return juce::String::fromUTF8 (utf8); }
+
+    juce::String lastError() { return text (soundpack_last_error()); }
+
+    void log (const juce::String& message) { juce::Logger::outputDebugString ("usf2plugin soundpacks: " + message); }
+
+    bool initialised()
+    {
+        static std::once_flag once;
+        static bool ok = false;
+
+        std::call_once (once, []
+        {
+            const auto context = juce::getAppContext();
+            ok = soundpack_init (juce::getEnv(), context.get()) == 0;
+
+            if (! ok)
+                log ("soundpack_init failed: " + lastError());
+        });
+
+        return ok;
+    }
+
+    // {"presets":[{"bank":0,"program":0,"name":"..."}]}, as the SF2 indexer stores it.
+    std::vector<PresetInfo> presetsOf (const juce::String& metadata)
+    {
+        std::vector<PresetInfo> result;
+        // Held in locals: getArray() points into the parsed value.
+        const auto json = juce::JSON::parse (metadata);
+        const auto list = json.getProperty ("presets", {});
+
+        if (auto* presets = list.getArray())
+            for (const auto& preset : *presets)
+                result.push_back ({ (int) preset.getProperty ("bank", 0),
+                                    (int) preset.getProperty ("program", 0),
+                                    preset.getProperty ("name", {}).toString() });
+
+        std::sort (result.begin(), result.end(), [] (const PresetInfo& a, const PresetInfo& b)
+        {
+            return a.bank != b.bank ? a.bank < b.bank : a.program < b.program;
+        });
+
+        return result;
+    }
+}
+
+std::vector<Entry> listEntries()
+{
+    std::vector<Entry> result;
+
+    if (! initialised())
+        return result;
+
+    auto* list = soundpack_list_entries ("sf2");
+
+    if (list == nullptr)
+    {
+        log ("listing SF2 entries failed: " + lastError());
+        return result;
+    }
+
+    for (size_t i = 0; i < soundpack_entry_list_count (list); ++i)
+        result.push_back ({ text (soundpack_entry_identity (list, i)),
+                            text (soundpack_entry_pack_label (list, i)),
+                            text (soundpack_entry_path (list, i)),
+                            text (soundpack_entry_label (list, i)),
+                            presetsOf (text (soundpack_entry_metadata (list, i))) });
+
+    soundpack_entry_list_free (list);
+    return result;
+}
+
+std::vector<Folder> folders()
+{
+    std::vector<Folder> result;
+
+    if (! initialised())
+        return result;
+
+    auto* list = soundpack_host_list_folders();
+
+    if (list == nullptr)
+    {
+        log ("listing folders failed: " + lastError());
+        return result;
+    }
+
+    for (size_t i = 0; i < soundpack_folder_count (list); ++i)
+    {
+        juce::StringArray kinds;
+        kinds.addTokens (text (soundpack_folder_kinds (list, i)), ",", {});
+
+        if (! kinds.contains ("sf2"))
+            continue;
+
+        result.push_back ({ text (soundpack_folder_id (list, i)),
+                            text (soundpack_folder_display_name (list, i)),
+                            text (soundpack_folder_tree_uri (list, i)),
+                            soundpack_folder_available (list, i) != 0,
+                            soundpack_folder_file_count (list, i),
+                            text (soundpack_folder_error (list, i)) });
+    }
+
+    soundpack_folder_list_free (list);
+    return result;
+}
+
+juce::String addFolder (const juce::String& treeUrl, juce::String& error)
+{
+    char id[256];
+
+    if (! initialised()
+          || soundpack_host_add_folder (treeUrl.toRawUTF8(), "sf2", id, sizeof (id)) != 0)
+    {
+        error = lastError();
+        return {};
+    }
+
+    return text (id);
+}
+
+bool removeFolder (const juce::String& folderId)
+{
+    return initialised() && soundpack_host_remove_folder (folderId.toRawUTF8()) == 0;
+}
+
+void rescanFolders()
+{
+    if (initialised() && soundpack_host_rescan (nullptr) != 0)
+        log ("rescanning folders failed: " + lastError());
+}
+
+juce::String identityOf (const juce::String& folderId, const juce::String& path)
+{
+    char identity[4096];
+
+    if (! initialised()
+          || soundpack_format_identity ("sf2", folderId.toRawUTF8(), path.toRawUTF8(),
+                                        identity, sizeof (identity)) != 0)
+        return {};
+
+    return text (identity);
+}
+
+bool withMappedEntry (const juce::String& identity,
+                      const std::function<void (const void* data, size_t size)>& use,
+                      juce::String& error)
+{
+    if (! initialised())
+    {
+        error = lastError();
+        return false;
+    }
+
+    auto* session = soundpack_open (identity.toRawUTF8());
+
+    if (session == nullptr)
+    {
+        error = lastError();
+        return false;
+    }
+
+    soundpack_mapping mapping;
+    const auto mapped = soundpack_session_map (session, soundpack_session_entry (session), &mapping) == 0;
+
+    if (! mapped)
+        error = lastError();
+
+    // The mapping outlives the session.
+    soundpack_session_close (session);
+
+    if (! mapped)
+        return false;
+
+    use (mapping.data, mapping.size);
+    soundpack_mapping_release (&mapping);
+    return true;
+}
+
+} // namespace usf2::soundpacks
