+#if JUCE_ANDROID
+bool AppSettings::addCustomDirectory (const juce::URL& url)
+{
+    const auto document = juce::AndroidDocument::fromTree (url);
+
+    if (! document.hasValue())
+        return false;
+
+    const auto info = document.getInfo();
+
+    if (! info.isDirectory() || ! info.canRead())
+        return false;
+
+    const auto key = url.toString (true);
+
+    for (const auto& folder : soundpacks::folders())
+        if (folder.treeUrl == key)
+            return false;
+
+    // Keep the picker's grant now: linking scans the folder, which can take a while.
+    juce::AndroidDocumentPermission::takePersistentReadWriteAccess (url);
+
+    juce::Thread::launch ([key]
+    {
+        juce::String error;
+
+        if (soundpacks::addFolder (key, error).isEmpty())
+            juce::Logger::outputDebugString ("usf2plugin: cannot link " + key + ": " + error);
+
+        juce::SharedResourcePointer<AppSettings>()->sendChangeMessage();
+    });
+
+    return true;
+}
+
+void AppSettings::removeCustomDirectory (const SoundFontDirectory& directory)
+{
+    if (directory.isLinkedFolder())
+    {
+        soundpacks::removeFolder (directory.folderId);
+        juce::AndroidDocumentPermission::releasePersistentReadWriteAccess (
+            juce::URL (directory.treeUrl));
+        sendChangeMessage();
+        return;
+    }
+
+    if (! directory.isDocumentTree())
+    {
+        removeCustomDirectory (directory.file);
+        return;
+    }
+
+    auto list = readList();
+
+    if (! list.contains (directory.treeUrl))
+        return;
+
+    list.removeString (directory.treeUrl);
+    writeList (list);
+    juce::AndroidDocumentPermission::releasePersistentReadWriteAccess (
+        juce::URL (directory.treeUrl));
+}
+
+void AppSettings::migrateLegacyFolders()
+{
+    static juce::CriticalSection migrating;
+    const juce::ScopedLock sl (migrating);
+
+    juce::StringArray legacy;
+
+    for (const auto& key : readList())
+        if (key.startsWithIgnoreCase ("content://"))
+            legacy.add (key);
+
+    if (legacy.isEmpty())
+        return;
+
+    for (const auto& key : legacy)
+    {
+        juce::String error;
+
+        if (soundpacks::addFolder (key, error).isEmpty())
+            juce::Logger::outputDebugString ("usf2plugin: folder " + key + " was not carried over: " + error);
+    }
+
+    auto list = readList();
+
+    for (const auto& key : legacy)
+        list.removeString (key);
+
+    writeList (list);
+}
+#endif
