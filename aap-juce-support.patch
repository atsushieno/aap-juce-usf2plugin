+//==============================================================================
+/** A configured SoundFont folder. On Android, shared-storage folders are
+    represented by a persisted Storage Access Framework tree URL rather than a
+    filesystem path. */
+struct SoundFontDirectory
+{
+    SoundFontDirectory() = default;
+    SoundFontDirectory (const juce::File& f) : file (f) {}
+
+    juce::File file;
+    juce::String treeUrl;
+    juce::String name;
+    juce::String folderId;   // Android: a folder linked through the soundpack libraries
+    bool available = true;   // for a linked folder, as of its last scan
+
+    bool isDocumentTree() const { return treeUrl.isNotEmpty(); }
+    bool isLinkedFolder() const { return folderId.isNotEmpty(); }
+    bool isAvailable() const;
+    juce::String displayName() const;
+    juce::String storageKey() const;
+
+    bool operator== (const SoundFontDirectory& other) const
+    {
+        return storageKey() == other.storageKey();
+    }
+};
