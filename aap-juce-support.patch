diff --git a/CMakeLists.txt b/CMakeLists.txt
index a488bb3..3690f3e 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -19,10 +19,45 @@ endif()
 
-include(cmake/CPM.cmake)
-
-CPMAddPackage(
-    NAME JUCE
-    GITHUB_REPOSITORY juce-framework/JUCE
-    GIT_TAG 9.0.0)
+if(ANDROID)
+    include(${AAP_JUCE_DIR}/cmake/CPM.cmake)
+    # AAP hosts the editor in another Android component, so JUCE must be patched
+    # before it is configured. A distinct cache key prevents an unpatched JUCE 9
+    # checkout from being reused by CPM.
+    CPMAddPackage(
+        NAME JUCE
+        GIT_REPOSITORY https://github.com/juce-framework/JUCE.git
+        GIT_TAG 9.0.0
+        CUSTOM_CACHE_KEY aap-usf2-9.0.0
+        PATCH_COMMAND git apply --ignore-space-change ${AAP_JUCE_DIR}/juce-patches/8.0.12/support-plugin-ui.patch
+        COMMAND git apply --ignore-space-change ${AAP_JUCE_DIR}/juce-patches/8.0.12/export-jni-symbols.patch
+        COMMAND git apply --ignore-space-change ${AAP_JUCE_DIR}/juce-patches/8.0.12/disable-detach-current-thread.patch
+        COMMAND git apply --ignore-space-change ${AAP_JUCE_DIR}/juce-patches/8.0.12/juce-component-peer-view-touch.patch
+        COMMAND git apply --ignore-space-change ${AAP_JUCE_DIR}/juce-patches/8.0.12/embedded-peer-window-guard.patch
+        COMMAND git apply --ignore-space-change ${AAP_JUCE_DIR}/juce-patches/9.0.0/popup-menu-android.patch
+        COMMAND git apply --ignore-space-change ${AAP_JUCE_DIR}/JUCE-support-Android-CMake.patch)
+
+    file(READ "${JUCE_SOURCE_DIR}/modules/juce_gui_basics/native/java/app/com/rmsl/juce/ComponentPeerView.java"
+         _AAP_JUCE_PATCH_PROBE)
+    if(NOT _AAP_JUCE_PATCH_PROBE MATCHES "getLocationOnScreen")
+        message(FATAL_ERROR
+            "JUCE source cache is stale or the AAP patches were not applied: ${JUCE_SOURCE_DIR}")
+    endif()
+
+    # Gradle compiles JUCE's Android Java sources through this stable path.
+    file(MAKE_DIRECTORY "${CMAKE_CURRENT_SOURCE_DIR}/modules")
+    file(REMOVE "${CMAKE_CURRENT_SOURCE_DIR}/modules/juce")
+    file(CREATE_LINK "${JUCE_SOURCE_DIR}" "${CMAKE_CURRENT_SOURCE_DIR}/modules/juce"
+         SYMBOLIC RESULT _AAP_JUCE_LINK_RESULT)
+    if(NOT EXISTS "${CMAKE_CURRENT_SOURCE_DIR}/modules/juce/CMakeLists.txt")
+        message(FATAL_ERROR
+            "Could not link modules/juce to JUCE (${_AAP_JUCE_LINK_RESULT})")
+    endif()
+else()
+    include(cmake/CPM.cmake)
+    CPMAddPackage(
+        NAME JUCE
+        GITHUB_REPOSITORY juce-framework/JUCE
+        GIT_TAG 9.0.0)
+endif()
 
