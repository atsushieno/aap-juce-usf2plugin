+std::unique_ptr<juce::InputStream> SoundFontFile::createInputStream() const
+{
+   #if JUCE_ANDROID
+    if (documentUrl.isNotEmpty())
+    {
+        const auto document = juce::AndroidDocument::fromDocument (juce::URL (documentUrl));
+        return document.hasValue() ? document.createInputStream() : nullptr;
+    }
+   #endif
+
+    return file.createInputStream();
+}
+
+bool SoundFontFile::loadData (juce::MemoryBlock& destination) const
+{
+    destination.reset();
+
+    if (auto stream = createInputStream())
+        return stream->readIntoMemoryBlock (destination) > 0;
+
+    return false;
+}
