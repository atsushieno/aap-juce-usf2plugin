+    bool isDocumentTree() const { return treeUrl.isNotEmpty(); }
+    bool isAvailable() const;
+    juce::String displayName() const;
+    juce::String storageKey() const;
+
+    bool operator== (const SoundFontDirectory& other) const
+    {
+        return storageKey() == other.storageKey();
