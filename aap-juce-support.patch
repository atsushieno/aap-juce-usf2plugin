+bool SoundFontFile::isValid() const
+{
+    if (bundled)
+        return true;
+
+   #if JUCE_ANDROID
+    if (documentUrl.isNotEmpty())
+    {
+        const auto document = juce::AndroidDocument::fromDocument (juce::URL (documentUrl));
+        return document.hasValue() && document.getInfo().isFile()
